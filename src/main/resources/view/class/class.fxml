<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="682.0" prefWidth="1066.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adeptus.adeptusfe.controller.classes.ClassController">
    <stylesheets>
        <URL value="@../../css/class.css" />
    </stylesheets>
    <children>
        <Label fx:id="headerLabel" layoutX="51.0" layoutY="45.0" text="Class" />
        <TextField layoutX="138.0" layoutY="101.0" prefHeight="34.0" prefWidth="149.0" />
        <Button fx:id="findButton" layoutX="306.0" layoutY="101.0" mnemonicParsing="false" prefHeight="34.0" prefWidth="52.0" text="find" />
        <Button onAction="#toNewClass" fx:id="newClassButton" layoutX="866.0" layoutY="101.0" mnemonicParsing="false" prefHeight="34.0" prefWidth="126.0" text="NEW CLASS" />
        <TableView onMouseClicked="#openClassDetail" fx:id="classTable" layoutX="38.0" layoutY="181.0" prefHeight="364.0" prefWidth="982.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="classNameColumn" prefWidth="191.0" text="Class Name" />
                <TableColumn fx:id="priceColumn" prefWidth="143.0" text="Price" />
                <TableColumn fx:id="teacherColumn" prefWidth="129.0" text="Teacher" />
                <TableColumn fx:id="staffColumn" prefWidth="139.0" text="Staff" />
                <TableColumn fx:id="courseColumn" prefWidth="130.0" text="Course" />
                <TableColumn fx:id="actionColumn" prefWidth="174.0" text="Action" />
            </columns>
        </TableView>
        <Button onAction="#prevPage" fx:id="prev" layoutX="395.0" layoutY="607.0" mnemonicParsing="false" text="Prev" />
        <Button onAction="#nextPage" fx:id="next" layoutX="578.0" layoutY="607.0" mnemonicParsing="false" text="Next" />
        <TextField fx:id="pageInput" layoutX="454.0" layoutY="607.0" prefHeight="34.0" prefWidth="100.0" />
    </children>
</AnchorPane>
