<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="682.0" prefWidth="1066.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adeptus.adeptusfe.controller.course.CourseController">
   <stylesheets>
      <URL value="@../../css/staff.css" />
   </stylesheets>
   <children>
      <Label layoutX="28.0" layoutY="22.0" text="COURSE" textFill="#b17457">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <TableView fx:id="courseTable" layoutX="14.0" layoutY="132.0" onMouseClicked="#openCourseDetail" prefHeight="432.0" prefWidth="1039.0">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="nameColumn" prefWidth="302.0" text="name" />
            <TableColumn fx:id="descriptionColumn" minWidth="0.0" prefWidth="354.0" text="description" />
            <TableColumn fx:id="action" minWidth="0.0" prefWidth="342.0" text="Action" />
         </columns>
      </TableView>
      <Button fx:id="newCourseButton" layoutX="896.0" layoutY="65.0" mnemonicParsing="false" onAction="#toNewCourse" prefHeight="36.0" prefWidth="135.0" text="NEW COURSE" />
      <TextField fx:id="searchInput" layoutX="218.0" layoutY="70.0" prefHeight="34.0" prefWidth="185.0" />
      <Button fx:id="findButton" layoutX="419.0" layoutY="70.0" mnemonicParsing="false" onAction="#handleSearch" prefHeight="34.0" prefWidth="62.0" text="Find" />
   </children>
</AnchorPane>
