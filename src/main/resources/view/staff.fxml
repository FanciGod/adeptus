<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="682.0" prefWidth="1066.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adeptus.adeptusfe.controller.StaffController">
    <stylesheets>
        <URL value="@../css/home.css" />
        <URL value="@../css/staff.css" />
    </stylesheets>
    <Label layoutX="28.0" layoutY="22.0" text="STAFF" textFill="#b17457">
        <font>
            <Font name="System Bold" size="25.0" />
        </font>
    </Label>
    <TableView fx:id="staffTable" layoutX="14.0" layoutY="132.0" onMouseClicked="#openStaffDetail" prefHeight="432.0" prefWidth="1039.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="40.0" text="ID" />
            <TableColumn fx:id="fullNameColumn" prefWidth="172.0" text="Full name" />
            <TableColumn fx:id="roleColumn" minWidth="0.0" prefWidth="145.0" text="Role" />
            <TableColumn fx:id="emailColumn" minWidth="0.0" prefWidth="183.0" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="126.0" text="Phone" />
            <TableColumn fx:id="dobColumn" minWidth="0.0" prefWidth="93.0" text="Date of birth" />
            <TableColumn fx:id="action" prefWidth="278.0" text="Action" />
        </columns>
    </TableView>
    <Button fx:id="newStaffButton" layoutX="896.0" layoutY="65.0" mnemonicParsing="false" onAction="#toNewStaff" prefHeight="36.0" prefWidth="135.0" text="NEW STAFF" />
    <Button layoutX="594.0" layoutY="601.0" mnemonicParsing="false" onAction="#nextPage" prefHeight="34.0" prefWidth="62.0" text="Next" />
    <Button layoutX="396.0" layoutY="601.0" mnemonicParsing="false" onAction="#prevPage" prefHeight="34.0" prefWidth="62.0" text="Prev" />
    <TextField fx:id="searchInput" layoutX="218.0" layoutY="70.0" prefHeight="34.0" prefWidth="185.0" />
    <Button fx:id="findButton" layoutX="419.0" layoutY="70.0" mnemonicParsing="false" onAction="#handleSearch" prefHeight="34.0" prefWidth="62.0" text="Find" />
    <TextField fx:id="pageInput" layoutX="479.0" layoutY="601.0" prefHeight="34.0" prefWidth="94.0" />
</AnchorPane>
