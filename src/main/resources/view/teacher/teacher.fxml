<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="682.0" prefWidth="1066.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adeptus.adeptusfe.controller.teacher.TeacherController">
   <stylesheets>
      <URL value="@../../css/staff.css" />
   </stylesheets>
   <children>
      <Label layoutX="28.0" layoutY="22.0" text="TEACHER" textFill="#b17457">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <Button fx:id="newTeacherButton" layoutX="865.0" layoutY="65.0" mnemonicParsing="false" onAction="#toNewTeacher" prefHeight="36.0" prefWidth="166.0" text="NEW TEACHER" />
      <TextField fx:id="searchInput" layoutX="218.0" layoutY="70.0" prefHeight="34.0" prefWidth="185.0" />
      <Button fx:id="findButton" layoutX="419.0" layoutY="70.0" mnemonicParsing="false" onAction="#handleSearch" prefHeight="34.0" prefWidth="62.0" text="Find" />
      <TableView onMouseClicked="#openTeacherDetail" fx:id="teacherTable" layoutX="83.0" layoutY="212.0" prefHeight="398.0" prefWidth="903.0">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="81.0" text="ID" />
          <TableColumn fx:id="teacherNameColumn" prefWidth="352.0" text="Teacher Name" />
            <TableColumn fx:id="phoneColumn" prefWidth="214.0" text="Phone Number" />
            <TableColumn fx:id="action" prefWidth="255.0" text="Action" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
